[Unit]
Description=NocturPod Edge Surveillance Agent Service
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=arxshar
Group=arxshar
SupplementaryGroups=gpio
WorkingDirectory=/home/arxshar/NocturPod
ExecStart=/home/arxshar/NocturPod/.venv/bin/python -u agent/main.py
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=GPIOZERO_PIN_FACTORY=lgpio
EnvironmentFile=/etc/nocturpod-agent.env

# Permit writes only to the local media spool and the project storage directory.
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/arxshar/nocturpod/media /home/arxshar/NocturPod/storage

[Install]
WantedBy=multi-user.target
