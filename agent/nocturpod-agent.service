[Unit]
Description=NocturPod Edge Surveillance Agent Service
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User, Group, WorkingDirectory and ExecStart if the Pi uses a username
# other than "pi" or the repository is installed somewhere else.
User=pi
Group=pi
WorkingDirectory=/home/pi/NocturPod
EnvironmentFile=-/etc/nocturpod/nocturpod.env
ExecStart=/home/pi/NocturPod/.venv/bin/python -u agent/main.py
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

# Filesystem permissions
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/nocturpod/media /home/pi/NocturPod/storage

[Install]
WantedBy=multi-user.target
