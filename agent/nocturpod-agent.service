[Unit]
Description=NocturPod Edge Surveillance Agent Service
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/NocturPod
ExecStart=/home/pi/NocturPod/.venv/bin/python -u agent/nocturpod_agent.py --backend http://127.0.0.1:5000
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=NOCTURPOD_DEVICE_ID=nocturpod-edge-01
Environment=NOCTURPOD_DEVICE_TOKEN=nocturpod-sec-key-2026

# Sandbox and hardware protections
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/NocturPod/storage

[Install]
WantedBy=multi-user.target
