# ==============================================================================
# NocturPod Edge Gateway & Dashboard Environment Configuration
# ==============================================================================
# CRITICAL SECURITY NOTICE:
# - NEVER commit real secrets or production keys to version control.
# - DO NOT deploy this dashboard publicly without a server-side authentication proxy
#   (Backend For Frontend / BFF) or an OAuth2/OIDC identity provider.
# - Client-side variables (prefixed with VITE_) are compiled into public JavaScript
#   bundles and are publicly readable by anyone accessing the web application.
# ==============================================================================

# --- Backend Edge Server Settings (api_server.py) ---
# Master secret API key for edge device administration, telemetry, and control.
# Must be set to a strong, high-entropy secret on the physical edge device.
# If unset, protected endpoints fail safely and return HTTP 503.
API_KEY=REPLACE_WITH_HIGH_ENTROPY_SERVER_SECRET_KEY

# Comma-separated list of trusted origins permitted for Cross-Origin Resource Sharing (CORS).
# Wildcard '*' is strictly rejected. Include your exact local dev or trusted dashboard origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory for edge storage (captures, footage, sqlite database)
STORAGE_DIR=storage

# Path to YOLO model weights (optional; uses yolov8n.pt by default if present)
MODEL_PATH=yolov8n.pt

# Network interface and port for the Flask edge gateway server
HOST=0.0.0.0
PORT=5000

# --- Frontend Dashboard Settings (Local Development / Testing Only) ---
# Base URL for API requests.
# - For local Vite development with proxy: /api
# - For local LAN direct edge access: http://<edge-ip>:5000/api or http://<edge-ip>:5000
VITE_API_BASE_URL=/api

# LOCAL TEST CREDENTIAL ONLY:
# Used strictly by automated integration tests and private local development.
# WARNING: In a production public deployment, this variable MUST NOT BE SET.
# Public deployments require a server-side BFF with user sessions.
VITE_API_KEY=LOCAL_DEV_ONLY_DO_NOT_USE_IN_PRODUCTION
