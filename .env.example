# NocturPod Environment Variables
# NEVER commit production credentials or secret keys to version control.

# -----------------------------------------------------------------------------
# Supabase Configuration (Backend)
# -----------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role key ONLY in backend environment variables (Render / local .env)
# NEVER expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Storage bucket name for NocturPod surveillance media (images & videos)
SUPABASE_STORAGE_BUCKET=nocturpod-media

# -----------------------------------------------------------------------------
# Device Authentication
# -----------------------------------------------------------------------------
# Shared secret between backend and Raspberry Pi agent
NOCTURPOD_DEVICE_TOKEN=nocturpod-sec-key-replace-with-secure-token
NOCTURPOD_DEVICE_ID=nocturpod-edge-01

# -----------------------------------------------------------------------------
# Backend Server Configuration (Render / Local)
# -----------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
MODEL_PATH=yolov8n.pt

# -----------------------------------------------------------------------------
# Raspberry Pi Device Agent Configuration (agent/config.py)
# -----------------------------------------------------------------------------
NOCTURPOD_BACKEND_URL=https://your-nocturpod-backend.onrender.com
LOCAL_MEDIA_DIR=/home/pi/nocturpod/media
CAMERA_INDEX=0

# -----------------------------------------------------------------------------
# Frontend Configuration (Vercel / .env.local)
# -----------------------------------------------------------------------------
# Public Render backend URL (no trailing slash)
VITE_API_URL=https://your-nocturpod-backend.onrender.com
